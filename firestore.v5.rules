rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isApexOwner() {
      return request.auth != null
        && request.auth.uid in [
          "fnc4G85CtmQVy0OooOzfOoSC9u22",
          "FqDrn1aPFHXUB5ogb2rN9D7mRG42",
          "maefd5cQ9qcIKSeU4b3yZKUL8UW2"
        ];
    }

    function isReasonableDocument() {
      return request.resource.data.size() <= 100;
    }

    match /customers/{id} {
      allow read, delete: if isApexOwner();
      allow create, update: if isApexOwner() && isReasonableDocument();
    }

    match /jobs/{id} {
      allow read, delete: if isApexOwner();
      allow create, update: if isApexOwner() && isReasonableDocument();
    }

    match /vouchers/{id} {
      allow read, delete: if isApexOwner();
      allow create, update: if isApexOwner() && isReasonableDocument();
    }

    match /bookingRequests/{id} {
      allow read, delete: if isApexOwner();
      allow create, update: if isApexOwner() && isReasonableDocument();
    }

    match /bookingLocks/{id} {
      allow read, delete: if isApexOwner();
      allow create, update: if isApexOwner() && isReasonableDocument();
    }

    match /inquiries/{id} {
      allow read, delete: if isApexOwner();
      allow create, update: if isApexOwner() && isReasonableDocument();
    }

    match /settings/{id} {
      allow read, delete: if isApexOwner();
      allow create, update: if isApexOwner() && isReasonableDocument();
    }

    // OAuth tokens, rate limits and integration state are server-only.
    match /integrations/{id} { allow read, write: if false; }
    match /oauthStates/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /calendarProspectDismissals/{id} { allow read, write: if isApexOwner(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
