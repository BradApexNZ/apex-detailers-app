{
  "name": "apex-detailers-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "launch:audit": "node scripts/launch-audit.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"functions/**/*.js\"",
    "check:frontend": "npm run build",
    "check:functions": "npm --prefix functions run check",
    "test:security": "node --test scripts/security-regression.test.mjs",
    "check": "npm run check:frontend && npm run check:functions && npm run test:security && npm run launch:audit",
    "deploy:hosting": "npm run check && firebase deploy --only hosting",
    "deploy:cloud": "npm run check:functions && firebase deploy --only functions,firestore:rules",
    "deploy:storage": "firebase deploy --only storage",
    "deploy": "npm run deploy:cloud && npm run deploy:hosting"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "jspdf": "^4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "prettier": "^3.9.6",
    "vite": "8.1.5"
  }
}
