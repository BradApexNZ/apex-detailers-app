rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isBrad() {
      return request.auth != null && request.auth.uid == "fnc4G85CtmQVy0OooOzfOoSC9u22";
    }

    function isSafeImageUpload() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /jobs/{customerId}/{fileName} {
      allow read, delete: if isBrad();
      allow create, update: if isBrad() && isSafeImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
